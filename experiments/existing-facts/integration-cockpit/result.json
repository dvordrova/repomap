  "p1": {
    "variant": "P1",
    "headline": "bbolt integration cockpit: connection, transactions, buckets, mutations, scans, diagnostics",
    "summary": "This cockpit catalogs bbolt usage across etcd server storage. It covers connection lifecycle, transaction control, bucket structure, key/value mutation, scan/read, and maintenance/diagnostics. Operations are exact external calls to bbolt symbols, validated by program index and activity outcome. Callers span backend and schema areas. Reachability is not represented in available facts.",
    "slot_notes": [
