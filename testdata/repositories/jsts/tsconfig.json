{
  "include": ["shared/**/*", "src/**/*"],
  "compilerOptions": {
    "allowJs": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "paths": {
      "@fixture/dependency-alias": ["./node_modules/@fixture/missing-sdk"]
    },
    "jsx": "preserve",
    "experimentalDecorators": true,
    "strict": true
  }
}
