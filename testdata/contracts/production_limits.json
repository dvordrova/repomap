{
  "version": 1,
  "scope": "named production hard bounds in Go constants under cmd/internal and JavaScript declarations under internal/jstsproject and internal/report/templates; derived runtime values, protocol/version/identity digest widths, minimum detection heuristics, and ordinary algorithmic literals are out of scope; false-positive names are explicit exclusions",
  "literal_exclusions": [
    {
      "file": "internal/corpus/corpus.go",
      "expression": "len(sha) < 24",
      "occurrences": 1,
      "reason": "Canonical FileID digest-prefix width, not a collection or resource ceiling."
    },
    {
      "file": "internal/deepseek/client.go",
      "expression": "resp.StatusCode < 200",
      "occurrences": 2,
      "reason": "HTTP success-range protocol boundary."
    },
    {
      "file": "internal/deepseek/client.go",
      "expression": "resp.StatusCode >= 300",
      "occurrences": 2,
      "reason": "HTTP success-range protocol boundary."
    },
    {
      "file": "internal/deepseek/client.go",
      "expression": "status >= 500",
      "occurrences": 1,
      "reason": "HTTP server-error class boundary, not a retry-count or time ceiling."
    },
    {
      "file": "internal/facts/model.go",
      "expression": "len(value) < 7",
      "occurrences": 1,
      "reason": "Shortest abbreviated Git revision accepted when validating a captured revision string; it is a format rule, not a resource ceiling."
    },
    {
      "file": "internal/facts/model.go",
      "expression": "len(value) > 64",
      "occurrences": 1,
      "reason": "Longest Git revision string accepted when validating a captured revision; it is a format rule, not a resource ceiling."
    },
    {
      "file": "internal/gofacts/package_declarations.go",
      "expression": "packageDeclarationKindOrder(kind) < 5",
      "occurrences": 1,
      "reason": "Closed enum ordering boundary for declaration kinds."
    },
    {
      "file": "internal/jstsproject/discover.go",
      "expression": "character >= 0x20",
      "occurrences": 1,
      "reason": "Unicode control-character boundary used while sanitizing diagnostics."
    },
    {
      "file": "internal/secretscan/secretscan.go",
      "expression": "len(token) >= 24",
      "occurrences": 1,
      "reason": "Opt-in credential-detection minimum heuristic."
    },
    {
      "file": "internal/secretscan/secretscan.go",
      "expression": "len(value) < 8",
      "occurrences": 1,
      "reason": "Opt-in credential-detection minimum heuristic."
    },
    {
      "file": "internal/secretscan/secretscan.go",
      "expression": "len(value) >= 16",
      "occurrences": 1,
      "reason": "Opt-in credential-detection minimum heuristic."
    },
    {
      "file": "internal/secretscan/secretscan.go",
